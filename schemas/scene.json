{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "Presence API scene",
	"description": "Experimental, and may change without notice. A scene the admin bar debugger directs with WP_DEBUG on. Every cue is an action from a fixed list, acted by users the scene casts on posts it writes itself.",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"apiVersion",
		"name",
		"title",
		"cast",
		"cues"
	],
	"properties": {
		"$schema": {
			"type": "string"
		},
		"apiVersion": {
			"description": "The scene format version. Newer formats are refused rather than half-read.",
			"const": 1
		},
		"name": {
			"description": "Namespace and name, like a block name.",
			"type": "string",
			"pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
		},
		"title": {
			"type": "string",
			"minLength": 1,
			"maxLength": 60
		},
		"cast": {
			"description": "One to seven actors, named Actor 1 onwards in this order.",
			"type": "array",
			"minItems": 1,
			"maxItems": 7,
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": [
					"role"
				],
				"properties": {
					"role": {
						"enum": [
							"subscriber",
							"contributor",
							"author",
							"editor"
						]
					}
				}
			}
		},
		"cues": {
			"type": "array",
			"minItems": 1,
			"maxItems": 30,
			"items": {
				"$ref": "#/definitions/cue"
			}
		}
	},
	"definitions": {
		"at": {
			"description": "Seconds from the start, never earlier than the cue before. A TTL offset such as \"25+ttl+5\" follows the site's presence timeout.",
			"oneOf": [
				{
					"type": "integer",
					"minimum": 0,
					"maximum": 900
				},
				{
					"type": "string",
					"pattern": "^([0-9]{1,3}\\+)?ttl(\\+[0-9]{1,3})?$"
				}
			]
		},
		"actor": {
			"type": "integer",
			"minimum": 1,
			"maximum": 7
		},
		"post": {
			"description": "The Nth post a write cue created.",
			"type": "integer",
			"minimum": 1
		},
		"text": {
			"type": "string",
			"minLength": 1,
			"maxLength": 100
		},
		"cue": {
			"type": "object",
			"required": [
				"at",
				"actor",
				"action"
			],
			"oneOf": [
				{
					"properties": {
						"at": {
							"$ref": "#/definitions/at"
						},
						"actor": {
							"oneOf": [
								{
									"$ref": "#/definitions/actor"
								},
								{
									"const": "cast"
								}
							]
						},
						"action": {
							"description": "Goes to an admin screen, closing any editor they had open.",
							"const": "visit"
						},
						"place": {
							"enum": [ "dashboard", "posts", "pages", "media", "comments", "profile" ]
						}
					},
					"required": [
						"place"
					],
					"additionalProperties": false
				},
				{
					"properties": {
						"at": {
							"$ref": "#/definitions/at"
						},
						"actor": {
							"$ref": "#/definitions/actor"
						},
						"action": {
							"description": "Writes a draft of their own and opens it in the editor.",
							"const": "write"
						},
						"title": {
							"$ref": "#/definitions/text"
						}
					},
					"required": [
						"title"
					],
					"additionalProperties": false
				},
				{
					"properties": {
						"at": {
							"$ref": "#/definitions/at"
						},
						"actor": {
							"$ref": "#/definitions/actor"
						},
						"action": {
							"description": "open: opens a post in the editor, taking the lock when nobody holds it. takeOver: takes the lock from whoever holds it. close: leaves the editor for the posts list, releasing their lock.",
							"enum": [
								"open",
								"takeOver",
								"close"
							]
						},
						"post": {
							"$ref": "#/definitions/post"
						}
					},
					"required": [
						"post"
					],
					"additionalProperties": false
				},
				{
					"properties": {
						"at": {
							"$ref": "#/definitions/at"
						},
						"actor": {
							"$ref": "#/definitions/actor"
						},
						"action": {
							"description": "Adds a paragraph to a post and saves it, failing while someone else holds the lock.",
							"const": "type"
						},
						"post": {
							"$ref": "#/definitions/post"
						},
						"text": {
							"$ref": "#/definitions/text"
						}
					},
					"required": [
						"post"
					],
					"additionalProperties": false
				},
				{
					"properties": {
						"at": {
							"$ref": "#/definitions/at"
						},
						"actor": {
							"oneOf": [
								{
									"$ref": "#/definitions/actor"
								},
								{
									"const": "cast"
								}
							]
						},
						"action": {
							"description": "drop: stops beating without saying goodbye, like a closed laptop. leave: logs out. checkOnline and checkOffline: fail unless the online list does or does not show them.",
							"enum": [
								"drop",
								"leave",
								"checkOnline",
								"checkOffline"
							]
						}
					},
					"additionalProperties": false
				},
				{
					"properties": {
						"at": {
							"$ref": "#/definitions/at"
						},
						"actor": {
							"$ref": "#/definitions/actor"
						},
						"action": {
							"description": "Fails unless someone else does (checkLocked) or nobody else does (checkUnlocked) hold the post's lock.",
							"enum": [
								"checkLocked",
								"checkUnlocked"
							]
						},
						"post": {
							"$ref": "#/definitions/post"
						}
					},
					"required": [
						"post"
					],
					"additionalProperties": false
				}
			]
		}
	}
}
