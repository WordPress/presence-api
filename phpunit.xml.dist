<?xml version="1.0"?>
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="http://schema.phpunit.de/9.2/phpunit.xsd"
	bootstrap="plugins/presence-api/tests/bootstrap.php"
	backupGlobals="false"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	beStrictAboutOutputDuringTests="true"
>
	<testsuites>
		<testsuite name="presence-api">
			<directory suffix=".php">plugins/presence-api/tests/</directory>
			<exclude>plugins/presence-api/tests/stubs</exclude>
			<exclude>plugins/presence-api/tests/bootstrap.php</exclude>
			<exclude>plugins/presence-api/tests/class-wp-presence-unittestcase.php</exclude>
			<exclude>plugins/presence-api/tests/class-wp-presence-network-unittestcase.php</exclude>
		</testsuite>
		<testsuite name="presence-scenes">
			<directory prefix="test-" suffix=".php">plugins/presence-scenes/</directory>
		</testsuite>
		<testsuite name="presence-debugger">
			<directory prefix="test-" suffix=".php">plugins/presence-debugger/</directory>
		</testsuite>
	</testsuites>
	<coverage>
		<include>
			<directory suffix=".php">plugins/presence-api/includes/</directory>
			<directory suffix=".php">plugins/presence-scenes/</directory>
		</include>
		<exclude>
			<!--
			WP_DEBUG-only developer tools. Excluded from the distributed zip via
			.distignore and from codecov.yml, so they are not measured as shipped
			product code either. scripts/check-debug-exclusions.sh checks all three
			lists agree.
			-->
			<!-- Only register hooks, and run during bootstrap before coverage starts. -->
			<file>plugins/presence-api/includes/default-filters.php</file>
			<file>plugins/presence-api/includes/ms-default-filters.php</file>
			<file>plugins/presence-scenes/load.php</file>
			<file>plugins/presence-scenes/uninstall.php</file>
			<directory>plugins/presence-scenes/tests/</directory>
		</exclude>
	</coverage>
</phpunit>
