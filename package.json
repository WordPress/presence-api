{
	"name": "presence-api",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"check": "bash scripts/check.sh",
		"env:start": "wp-env start",
		"env:start:multisite": "bash scripts/start-multisite-env.sh",
		"env:stop": "wp-env stop",
		"env:stop:multisite": "cd tests/e2e/multisite && wp-env stop",
		"env:cli": "wp-env run cli wp",
		"lint:js": "wp-scripts lint-js",
		"test": "wp-env run tests-cli --env-cwd='presence-api' -- ./vendor/bin/phpunit --testdox",
		"test:multisite": "wp-env run tests-cli --env-cwd='presence-api' -- env WP_MULTISITE=1 ./vendor/bin/phpunit --testdox",
		"test:e2e": "playwright test --config tests/e2e/playwright.config.js",
		"test:scenes": "playwright test --config tests/scenes/playwright.config.js",
		"test:scripts": "node --test .github/scripts/*.test.js",
		"test:unit": "wp-scripts test-unit-js"
	},
	"devDependencies": {
		"@playwright/test": "^1.63.0",
		"@testing-library/react": "^16.3.3",
		"@wordpress/e2e-test-utils-playwright": "^2.1.0",
		"@wordpress/env": "^11.16.0",
		"@wordpress/eslint-plugin": "^27.0.0",
		"@wordpress/scripts": "^36.0.0",
		"globals": "^17.12.0",
		"jquery": "^4.0.0",
		"jsdom": "^30.1.1",
		"vite": "^8.3.1",
		"vitest": "^5.0.3"
	},
	"peerDependencies": {
		"@wordpress/api-fetch": "^7.0.0",
		"@wordpress/components": "^42.0.0",
		"@wordpress/compose": "^8.10.0",
		"@wordpress/data": "^10.0.0",
		"@wordpress/element": "^6.0.0",
		"@wordpress/hooks": "^4.0.0",
		"@wordpress/i18n": "^6.30.0"
	}
}
