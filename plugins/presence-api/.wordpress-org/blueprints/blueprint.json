{
	"$schema": "https://playground.wordpress.net/blueprint-schema.json",
	"landingPage": "/wp-admin/index.php",
	"preferredVersions": {
		"php": "latest",
		"wp": "latest"
	},
	"login": true,
	"features": {
		"networking": true
	},
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "wordpress.org/plugins",
				"slug": "presence-api"
			},
			"options": {
				"activate": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/presence-api",
				"ref": "v0.16.1",
				"path": "plugins/presence-debugger"
			},
			"options": {
				"targetFolderName": "presence-debugger"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/presence-api/demo-seeder.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/v0.16.1/tests/e2e/demo-seeder.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/screen-stale-demo-helper.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/v0.16.1/tests/e2e/screen-stale-demo-helper.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/presence-api/demo-seeder.php'; update_option( 'avatar_default', 'identicon' ); wp_presence_demo_seed( 25 ); update_user_meta( 1, 'show_welcome_panel', 0 ); update_user_meta( 1, 'meta-box-order_dashboard', array( 'normal' => 'presence_active_posts,dashboard_right_now,dashboard_activity', 'side' => 'dashboard_quick_press,dashboard_primary' ) ); ?>"
		}
	]
}
