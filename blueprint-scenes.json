{
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"landingPage": "/wp-admin/edit.php?presence_scene=editing-together",
	"login": true,
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/preview-main/presence-api.zip"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/preview-main/presence-debugger.zip"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "git:directory",
				"url": "https://github.com/WordPress/presence-api",
				"ref": "main",
				"path": "plugins/presence-scenes"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/scene-demo-helper.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/main/tests/e2e/scene-demo-helper.php"
			}
		}
	]
}
