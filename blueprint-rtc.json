{
	"preferredVersions": {
		"php": "8.3",
		"wp": "latest"
	},
	"landingPage": "/wp-admin/?presence_demo=rtc",
	"login": true,
	"steps": [
		{
			"step": "defineWpConfigConsts",
			"consts": {
				"WP_DEBUG": true
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/preview-main/presence-api.zip"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/preview-main/presence-debugger.zip"
			}
		},
		{
			"step": "installPlugin",
			"pluginData": {
				"resource": "url",
				"url": "https://github.com/WordPress/gutenberg-sync-engines/releases/latest/download/gutenberg-sync-engines.zip"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/plugins/presence-api/demo-seeder.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/main/tests/e2e/demo-seeder.php"
			}
		},
		{
			"step": "writeFile",
			"path": "/wordpress/wp-content/mu-plugins/screen-stale-demo-helper.php",
			"data": {
				"resource": "url",
				"url": "https://raw.githubusercontent.com/WordPress/presence-api/main/tests/e2e/screen-stale-demo-helper.php"
			}
		},
		{
			"step": "runPHP",
			"code": "<?php require '/wordpress/wp-load.php'; require '/wordpress/wp-content/plugins/presence-api/demo-seeder.php'; global $wpdb; update_option( 'avatar_default', 'identicon' ); wp_presence_demo_seed( 25 ); update_option( 'presence_demo_rtc_post', wp_presence_demo_seed_collaborators() ); update_user_meta( 1, $wpdb->get_blog_prefix() . 'persisted_preferences', array( 'core/edit-post' => array( 'welcomeGuide' => false ), '_modified' => gmdate( 'c' ) ) ); ?>"
		}
	]
}
